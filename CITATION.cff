    given-names: Evangelos
    email: vagkaratzas1990@gmail.com
repository-code: "https://github.com/vagkaratzas/mgnifam"
url: "https://pypi.org/project/mgnifam/"
license: MIT
keywords:
  - bioinformatics
  - protein-families
  - hmm
  - hmmer
  - msa
  - metagenomics
